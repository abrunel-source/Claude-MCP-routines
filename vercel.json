{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm -w run vercel-build",
  "outputDirectory": "web",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "functions": {
    "api/[[...path]].js": {
      "maxDuration": 30,
      "includeFiles": "dist/apps/api/**"
    }
  },
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
