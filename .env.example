# ============================================================================
# Cadence environment configuration (copy to .env and fill in)
# Never commit a real .env. All deploy secrets are injected as env vars only.
# ============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
API_PORT=3000
WEB_PORT=4200
# Public base URL of the API (no trailing slash)
API_BASE_URL=http://localhost:3000
# Apex domain that tenant subdomains hang off (firm.<APP_ROOT_DOMAIN>)
APP_ROOT_DOMAIN=cadence.co.za
# Brunel (platform) host(s), comma-separated — these route to the platform surface
PLATFORM_HOSTS=app.cadence.co.za,admin.cadence.co.za,localhost

# --- Database (Supabase Postgres now / Cloud SQL later) --------------------
# Plain Postgres connection string via Prisma. Do NOT use supabase-js.
DATABASE_URL=postgresql://cadence:cadence@localhost:5432/cadence?schema=public

# --- Auth ------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=900            # seconds (15 min)
JWT_REFRESH_TTL=2592000       # seconds (30 days)
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Encryption (EnvAesKeyProvider now / Cloud KMS later) ------------------
# 32-byte master key, base64-encoded. Generate: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=

# --- Adapter selection (real | mock) ---------------------------------------
# When a real credential is absent, leave as 'mock' to run end-to-end.
PAYMENT_PROVIDER=mock
ACCOUNTING_PROVIDER=mock
NOTIFICATION_PROVIDER=mock

# --- Stitch (Payments — Layer A platform + per-tenant Layer B) -------------
# TODO(production-credentials): supply real Stitch client credentials.
STITCH_GRAPHQL_URL=https://api.stitch.money/graphql
STITCH_TOKEN_URL=https://secure.stitch.money/connect/token
# Brunel's own Stitch account (Layer A platform billing)
STITCH_PLATFORM_CLIENT_ID=
STITCH_PLATFORM_CLIENT_SECRET=
STITCH_PLATFORM_SIGNING_KEY=
STITCH_WEBHOOK_SECRET=

# --- Xero (Accounting) -----------------------------------------------------
# TODO(production-credentials): supply real Xero app credentials.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3000/api/integrations/xero/callback

# --- Resend (Email) --------------------------------------------------------
# TODO(production-credentials): supply real Resend API key + sender domain.
RESEND_API_KEY=
RESEND_DEFAULT_FROM=Cadence <no-reply@cadence.co.za>

# --- Object storage (S3-compatible: Supabase Storage / R2 / GCS XML) -------
# TODO(production-credentials): supply real S3-compatible credentials.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=cadence
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Scheduler / job runner ------------------------------------------------
# Shared secret the cron trigger presents to the protected worker endpoint.
CRON_SECRET=change-me-cron-secret

# --- Commercial defaults (South Africa) ------------------------------------
DEFAULT_CURRENCY=ZAR
DEFAULT_VAT_RATE=15
TRIAL_DAYS=14
