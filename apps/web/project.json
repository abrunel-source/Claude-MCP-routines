{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "ng build", "cwd": "apps/web" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "ng serve", "cwd": "apps/web" }
    }
  }
}
