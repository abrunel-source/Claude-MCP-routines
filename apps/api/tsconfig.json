{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "outDir": "../../dist/apps/api",
    "baseUrl": "./",
    "types": ["node", "jest"],
    "paths": {
